FROM apache/airflow:2.7.0-python3.9

USER root
# Install packages for compilation/building if necessary
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    sqlite3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install python dependencies required by the ETL tasks and validation
RUN pip install --no-cache-dir \
    pandas==1.5.3 \
    pyarrow==11.0.0 \
    great-expectations==0.16.8 \
    pytest==7.3.1 \
    requests==2.31.0 \
    openpyxl==3.1.2
